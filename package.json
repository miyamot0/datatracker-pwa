    "@vitest/web-worker": "5.0.5",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.0.3",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^30.1.3",
    "knip": "^6.7.0",
    "license-report": "^6.8.0",
