    "vite-plugin-csp-guard": "^4.0.1",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^5.0.5",
    "vitest-browser-react": "^2.3.0"
  },
  "resolutions": {
    "mdast-util-to-hast": "^13.2.1",
