{
  "name": "data-tracker",
  "type": "module",
  "engines": {
    "node": "24.22.1"
  },
  "description": "DataTracker is a web application that helps you to track various forms of behavioral phenomena",
  "homepage": "https://www.smallnstats.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/miyamot0/datatracker-pwa"
  },
  "author": {
    "name": "Shawn P. Gilroy",
    "url": "https://www.smallnstats.com",
    "email": "sgilroy1@lsu.edu"
  },
  "maintainers": [
    {
      "name": "Shawn P. Gilroy",
      "url": "https://www.smallnstats.com",
      "email": "sgilroy1@lsu.edu"
    }
  ],
  "private": true,
  "bugs": {
    "url": "https://github.com/miyamot0/datatracker-pwa/issues"
  },
  "keywords": [
    "behavioral data",
    "data collection",
    "single case design",
    "research software"
  ],
  "license": "Apache-2.0",
  "version": "0.5.15",
  "scripts": {
    "dev-island": "vite --mode island",
    "dev": "vite",
    "build-island": "node node_modules/typescript-native/bin/tsc && vite build --mode island",
    "build-docker": "node node_modules/typescript-native/bin/tsc && vite build",
    "build": "node node_modules/typescript-native/bin/tsc && vite build",
    "build:peek": "node node_modules/typescript-native/bin/tsc --showConfig --listFiles",
    "build:quick": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "preview-island": "vite preview --outDir ./dist-island",
    "check-licenses": "npx license-report --only=prod --output=json > ./src/assets/licenses.json",
    "build-readme": "tsx ./scripts/index.ts",
    "build-demo-archive": "tsx ./scripts/build-demo-archive.ts",
    "prebuild": "yarn run lint && yarn run test && yarn run check-licenses && yarn run build-readme",
    "commit": "git add . && git commit -m \"automated commit\"",
    "push": "yarn run build && yarn run commit && git push",
    "test": "vitest run --coverage",
    "test-old": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "knip": "knip"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-menubar": "^1.1.1",
    "@radix-ui/react-scroll-area": "^1.1.0",
    "@radix-ui/react-select": "^2.1.1",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.1.2",
    "@tanstack/react-hotkeys": "^0.10.0",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "lucide-react": "^0.577.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.52.2",
    "react-use-pwa-install": "^1.0.1",
    "recharts": "3.10.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.5.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/highlight": "^1.2.0",
    "@tanstack/markdown": "^1.0.0",
    "@tanstack/router-plugin": "^1.168.48",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/wicg-file-system-access": "^2023.10.5",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/browser": "5.0.5",
    "@vitest/browser-playwright": "5.0.5",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/web-worker": "5.0.5",
    "eslint": "^10.0.3",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jsdom": "^30.1.3",
    "knip": "^6.7.0",
    "license-report": "^6.8.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.57.0",
    "typescript-native": "npm:typescript@^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-csp-guard": "^4.0.1",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^5.0.5",
    "vitest-browser-react": "^2.3.0"
  },
  "findUnusedExports": {
    "include": [
      "./src/**/*.d.ts",
      "src/**/*.{tsx,ts}"
    ]
  }
}
